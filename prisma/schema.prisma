generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String               @id @default(uuid())
  name            String
  email           String               @unique
  passwordHash    String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  sessions        Session[]
  leads           Lead[]
  prototypes      Prototype[]
  prototypeAssets PrototypeAsset[]
  proposals       CommercialProposal[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Category {
  id                   String             @id @default(uuid())
  name                 String             @unique
  prototypeCategoryKey String?
  approachTemplates    ApproachTemplate[]
  createdAt            DateTime           @default(now())
  leads                Lead[]

  @@map("categories")
}

model ApproachTemplate {
  id         String   @id @default(uuid())
  categoryId String
  title      String
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("approach_templates")
}

enum LeadSource {
  GOOGLE_PLACES
  MANUAL
}

enum LeadStatus {
  NOVO
  PROPOSTA_ENVIADA
  GANHO
  PERDIDO
}

model Lead {
  id              String               @id @default(uuid())
  userId          String
  source          LeadSource
  sourceId        String?
  categoryId      String
  name            String
  address         String?
  website         String?
  phone           String?
  status          LeadStatus           @default(NOVO)
  statusRevision  Int                  @default(0)
  rating          Float?
  userRatingCount Int?
  score           Int?
  wizardStep      Int                  @default(1)
  notes           String?
  interactions    LeadInteraction[]
  statusHistory   LeadStatusHistory[]
  prototypes      Prototype[]
  proposals       CommercialProposal[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category             @relation(fields: [categoryId], references: [id])

  @@unique([userId, source, sourceId])
  @@index([userId, status])
  @@map("leads")
}

model LeadStatusHistory {
  id         String     @id @default(uuid())
  leadId     String
  fromStatus LeadStatus
  toStatus   LeadStatus
  revision   Int
  occurredAt DateTime   @db.Timestamptz(3)
  recordedAt DateTime   @default(now()) @db.Timestamptz(3)
  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, revision])
  @@index([leadId, occurredAt])
  @@map("lead_status_history")
}

model LeadInteraction {
  id        String             @id @default(uuid())
  leadId    String
  channel   InteractionChannel
  type      InteractionType
  notes     String?            @db.Text
  createdAt DateTime           @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_interactions")
}

enum InteractionChannel {
  WHATSAPP
  INSTAGRAM
  EMAIL
  PHONE
  OTHER
}

enum InteractionType {
  FIRST_CONTACT
  FOLLOW_UP
  RESPONSE_RECEIVED
  MEETING
  OTHER
}

model Prototype {
  id              String             @id @default(uuid())
  userId          String
  name            String
  templateId      String
  templateVersion Int
  draftDocument   Json               @db.JsonB
  draftRevision   Int                @default(0)
  versionSequence Int                @default(0)
  leadId          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead            Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  versions        PrototypeVersion[]
  assets          PrototypeAsset[]

  @@index([userId, updatedAt])
  @@index([leadId])
  @@map("prototypes")
}

model PrototypeVersion {
  id          String              @id @default(uuid())
  prototypeId String
  number      Int
  document    Json                @db.JsonB
  createdAt   DateTime            @default(now())
  prototype   Prototype           @relation(fields: [prototypeId], references: [id], onDelete: Cascade)
  thumbnail   PrototypeThumbnail?

  @@unique([prototypeId, number])
  @@map("prototype_versions")
}

// Derived artifact: its lifecycle never updates the immutable version document.
model PrototypeThumbnail {
  versionId      String           @id
  objectKey      String           @unique
  status         String
  attemptId      String
  leaseExpiresAt DateTime
  generatedAt    DateTime?
  createdAt      DateTime         @default(now())
  version        PrototypeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("prototype_thumbnails")
}

model PrototypeAsset {
  id                  String     @id @default(uuid())
  userId              String
  prototypeId         String?
  objectKey           String     @unique
  originalName        String
  mimeType            String
  sizeBytes           Int
  width               Int
  height              Int
  sha256              String
  createdAt           DateTime   @default(now())
  deletionRequestedAt DateTime?
  deletedAt           DateTime?
  user                User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  prototype           Prototype? @relation(fields: [prototypeId], references: [id], onDelete: SetNull)

  @@index([userId, prototypeId, createdAt])
  @@map("prototype_assets")
}

enum ProposalStatus {
  RASCUNHO
  ENVIADA
  ACEITA
  RECUSADA
  EXPIRADA
}

enum ProposalPaymentMethod {
  PIX
  CARTAO
}

enum ProposalPaymentMode {
  A_NEGOCIAR
  DEFINIDAS
}

model CommercialProposal {
  id                  String                  @id @default(uuid())
  userId              String
  leadId              String
  sourceProposalId    String?
  title               String
  description         String                  @db.Text
  scope               String                  @db.Text
  total               Decimal                 @db.Decimal(12, 2)
  paymentMode         ProposalPaymentMode     @default(DEFINIDAS)
  deposit             Decimal?                @db.Decimal(12, 2)
  depositMethod       ProposalPaymentMethod?
  depositInstallments Int?
  balanceMethod       ProposalPaymentMethod?
  balanceInstallments Int?
  deliveryDays        Int
  validUntil          DateTime                @db.Date
  notes               String                  @db.Text
  managedHosting      Boolean                 @default(false)
  monthlyAmount       Decimal?                @db.Decimal(12, 2)
  maintenance         String                  @db.Text
  clientName          String
  clientAddress       String?
  clientPhone         String?
  issuerName          String
  issuerEmail         String
  status              ProposalStatus          @default(RASCUNHO)
  revision            Int                     @default(0)
  lockedAt            DateTime?               @db.Timestamptz(3)
  deletedAt           DateTime?               @db.Timestamptz(3)
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(3)
  user                User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  lead                Lead                    @relation(fields: [leadId], references: [id], onDelete: Restrict)
  source              CommercialProposal?     @relation("ProposalRevisions", fields: [sourceProposalId], references: [id], onDelete: Restrict)
  revisions           CommercialProposal[]    @relation("ProposalRevisions")
  history             ProposalStatusHistory[]

  @@index([userId, leadId, deletedAt, createdAt])
  @@index([sourceProposalId])
  @@map("commercial_proposals")
}

model ProposalStatusHistory {
  id         String             @id @default(uuid())
  proposalId String
  fromStatus ProposalStatus
  toStatus   ProposalStatus
  revision   Int
  occurredAt DateTime           @default(now()) @db.Timestamptz(3)
  proposal   CommercialProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  @@unique([proposalId, revision])
  @@map("proposal_status_history")
}
